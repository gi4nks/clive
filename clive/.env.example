# Clive AI provider config (gateway reads env vars; shell wins over this file).
# Copy to ~/.clive/ai.env (managed by Settings → AI) or export in your shell.
# Custom OpenAI-compatible providers: CLIVE_PROVIDER_<ID>_BASE_URL / _API_KEY

# --- Built-in: Ollama local (key optional) ---
CLIVE_PROVIDER_OLLAMA_BASE_URL=http://localhost:11434/v1
CLIVE_PROVIDER_OLLAMA_API_KEY=ollama

# --- Example custom provider ---
# CLIVE_PROVIDER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# CLIVE_PROVIDER_OPENROUTER_API_KEY=sk-or-…
