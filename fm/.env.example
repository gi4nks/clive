# clive AI Gateway provider config.
# Copy to `.env` (same folder) and fill in the secret key(s).
# Values already present in the environment are NOT overridden.

# --- OpenCode Go (default target) ---
GLB_OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
GLB_OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
GLB_OPENCODE_API_KEY=

# --- Ollama on lab-server (key optional) ---
GLB_OLLAMA_BASE_URL=http://lab-server:11434/v1
GLB_OLLAMA_API_KEY=
