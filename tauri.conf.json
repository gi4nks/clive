{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clive",
  "version": "1.2.1",
  "identifier": "com.gi4nks.filemanager",
  "build": {
    "beforeDevCommand": "make -C \"$(git rev-parse --show-toplevel)\" frontend-dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "make -C \"$(git rev-parse --show-toplevel)\" frontend-build",
    "frontendDist": "frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clive",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "dragDropEnabled": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 20
        },
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
